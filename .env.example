PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/khushal_finance?retryWrites=true&w=majority

# JWT Authentication (Session Expiry: 15m)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=15m

# CORS Allowed Origin & Frontend URL
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=your_email@example.com
EMAIL_FROM_NAME=Khushal Finance
ADMIN_EMAIL=your_email@example.com
